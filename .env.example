# Copy to .env. Never commit the real key.
# Required for CFBD. Free tier ~1000 calls/month. Cron only uses games+lines.
CFBD_API_KEY=
# Optional. Needed only to download TabPFN-3 weights.
TABPFN_TOKEN=
# In-app Ask tab. Server only — never send this to the browser.
DEEPSEEK=
# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=
